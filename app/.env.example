# Copy to .env.local (git-ignored) and fill in. Expo inlines EXPO_PUBLIC_* values
# into the app bundle, so only public values belong here.
# NEVER put server-only keys here (the Supabase secret key, the YouTube key).

# Supabase project URL and anon (public) key, from Project Settings -> API.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The ai-server (see ../ai-server). On a phone, use the laptop's LAN IP or a tunnel URL.
EXPO_PUBLIC_AI_SERVER_URL=http://127.0.0.1:3001

# Mock mode: "1" serves typed fake data for everything (no Supabase, no ai-server).
# "ai" uses real Supabase but fakes the ai-server calls. Empty or "0" = live.
EXPO_PUBLIC_MOCK_MODE=1

# Mock mode only: force the check-in XP result to "awarded" (default), "failed" or "skipped".
EXPO_PUBLIC_MOCK_XP_STATUS=awarded
