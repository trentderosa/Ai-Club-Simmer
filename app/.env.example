# Copy to .env.local (git-ignored) and fill in.
# Only public values go here: everything EXPO_PUBLIC_* is bundled into the app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Address of the AI server on the team laptop (LAN IP or tunnel URL).
EXPO_PUBLIC_AI_SERVER_URL=http://192.168.1.50:8787
