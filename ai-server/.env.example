# Simmer AI Server Environment Variables
# Copy this file to .env and fill in your values

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_MAX_TOKENS=1500
OLLAMA_TIMEOUT_MS=60000

# Server Configuration
PORT=3001
# SECURITY: Default is 127.0.0.1 (localhost only). Set to 0.0.0.0 only for
# production behind a reverse proxy or when explicitly needed for local network access.
HOST=127.0.0.1

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10

# Development Options (NEVER enable in production)
# ALLOW_STUB_AUTH=true      # Accept any Bearer token as valid (blocked in NODE_ENV=production)
# ENABLE_PREVIEW_ROUTE=true # Enable /generate-preview endpoint (unauthenticated)

# Supabase Configuration
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT Verification (required for production - provide ONE of these)
# SUPABASE_JWT_SECRET=your-jwt-secret      # For HS256 verification (from Supabase dashboard)
# SUPABASE_JWKS_URI=https://your-project.supabase.co/auth/v1/.well-known/jwks.json  # For RS256 verification
