# Simmer AI Server Environment Variables
# Copy this file to .env only if you do not already have one, then fill in values.

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_MAX_TOKENS=1500
OLLAMA_TIMEOUT_MS=60000
# One shared queue for every Ollama call. A full queue or a long wait returns 503 GENERATION_BUSY.
OLLAMA_MAX_CONCURRENT=1
OLLAMA_MAX_QUEUE=3
OLLAMA_QUEUE_TIMEOUT_MS=60000
OLLAMA_COACH_NOTE_QUEUE_TIMEOUT_MS=15000
# Total time one request may spend queueing and running, retries included.
OLLAMA_REQUEST_BUDGET_MS=170000
OLLAMA_COACH_NOTE_BUDGET_MS=120000

# Server Configuration
PORT=3001
# Default 127.0.0.1 listens on this machine only. That is the tunnel demo:
# keep HOST=127.0.0.1, set TRUST_PROXY=true, and point cloudflared or ngrok
# at http://127.0.0.1:3001. HOST=0.0.0.0 is only for same-Wi-Fi with no tunnel.
# Loopback trust makes that safe: a LAN client cannot spoof X-Forwarded-For.
HOST=127.0.0.1

# Exactly true when Cloudflare Tunnel or ngrok on this laptop connects to
# loopback. X-Forwarded-For counts only for that peer, so per-IP rate limits
# see the phone. Safe together with HOST=0.0.0.0.
# TRUST_PROXY=true

# CORS: comma-separated browser origins allowed to call this server (Expo web).
# Unset or empty uses the Expo dev/web defaults below. Never use *.
# Setting this replaces those defaults, so list every origin you still want,
# including the localhost ones. The GitHub Pages app origin is the host only
# (no /Ai-Club-Simmer path). A phone demo of that app must include it:
# ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://127.0.0.1:19006,https://trentderosa.github.io

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10

# Development Options (NEVER enable in production)
# ALLOW_STUB_AUTH=true      # Accept any Bearer token as valid (blocked in NODE_ENV=production)
# ENABLE_PREVIEW_ROUTE=true # Dev only. Ignored when NODE_ENV=production (route stays off; startup warns).

# Supabase Configuration
# Required when NODE_ENV=production (the server refuses to start without them).
# The service-role key lets the server save check-ins and call award_slot_xp,
# which is EXECUTE-granted to service_role only. Server-side only: never ship it
# to the app, never commit it, never log it.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder

# JWT verification (required for real auth and persistent storage).
# This project's Supabase Auth tokens are ES256 (asymmetric). Set
# SUPABASE_JWKS_URI, or at startup the server fail-closes to stub
# in-memory storage: auth/check-ins stay disabled and recipes are not
# saved to Supabase.
# SUPABASE_JWKS_URI=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
#
# Optional alternative for HS256 projects only (not this project):
# SUPABASE_JWT_SECRET=your-jwt-secret-placeholder

# XP awards (optional)
# Timeout for each award_slot_xp call; a timeout counts as a failed award (check-in kept).
# XP_AWARD_TIMEOUT_MS=5000

# XP reconcile job (npm run reconcile:xp, and the in-server schedule), optional; uses SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY
# How often the server retries missing XP awards, in ms. 0 turns it off; otherwise 60000 to 86400000.
# XP_RECONCILE_INTERVAL_MS=600000
# XP_RECONCILE_LOOKBACK_HOURS=168
# XP_RECONCILE_MIN_AGE_SECONDS=120
# XP_RECONCILE_BATCH_LIMIT=100
# Failed award attempts per check-in before reconcile gives up on it (1 to 100).
# XP_RECONCILE_MAX_ATTEMPTS=15
# Retry backoff base in minutes (1 to 1440): n failures wait base * 2^(n-1) minutes, max 24 h.
# XP_RECONCILE_RETRY_BASE_MINUTES=10

# Technique videos (F4), optional. Without a key, recipes have no videos.
# YouTube Data API v3 key: server only, never ship it in the app.
# YOUTUBE_API_KEY=your-youtube-api-key-placeholder
# YOUTUBE_TIMEOUT_MS=5000
# Time budget for all of one recipe's searches together (ms, 100-60000)
# VIDEO_LOOKUP_BUDGET_MS=8000

# Cook anything (optional)
# COOK_ANYTHING_MAX_DISH_LENGTH=80
# Per-user cap on uncached generations (Ollama + YouTube). Cache hits are not limited.
# With Supabase configured, the count is stored in cook_anything_generation_hits
# and survives a restart. That table comes from migration
# 20261120150000_cook_anything_generation_limits.sql, which a person must already
# have applied. This server does not apply it. Dev without Supabase keeps an
# in-memory count.
# COOK_ANYTHING_RATE_LIMIT_WINDOW_MS=3600000
# COOK_ANYTHING_RATE_LIMIT_MAX=5

# Cook anything dish photos (Wikimedia Commons, no API key).
# Timeout for one lookup in ms (500-10000). A timeout or failure returns photo: null
# and never fails recipe generation.
# DISH_PHOTO_LOOKUP_TIMEOUT_MS=2500
