# Simmer AI Server Environment Variables
# Copy this file to .env and fill in your values

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_MAX_TOKENS=1500
OLLAMA_TIMEOUT_MS=60000

# Server Configuration
PORT=3001
# SECURITY: Default is 127.0.0.1 (localhost only). Set to 0.0.0.0 only for
# production behind a reverse proxy or when explicitly needed for local network access.
HOST=127.0.0.1

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10

# Development Options (NEVER enable in production)
# ALLOW_STUB_AUTH=true      # Accept any Bearer token as valid (blocked in NODE_ENV=production)
# ENABLE_PREVIEW_ROUTE=true # Enable /generate-preview endpoint (unauthenticated)

# Supabase Configuration
# Required when NODE_ENV=production (the server refuses to start without them).
# The service-role key lets the server save check-ins and call award_slot_xp,
# which is EXECUTE-granted to service_role only. Server-side only: never ship it
# to the app, never commit it, never log it.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder

# JWT Verification (required for production - provide ONE of these)
# SUPABASE_JWT_SECRET=your-jwt-secret-placeholder      # For HS256 verification (from Supabase dashboard)
# SUPABASE_JWKS_URI=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json  # For RS256 verification

# XP awards (optional)
# Timeout for each award_slot_xp call; a timeout counts as a failed award (check-in kept).
# XP_AWARD_TIMEOUT_MS=5000

# XP reconcile job (npm run reconcile:xp), optional; uses SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY
# XP_RECONCILE_LOOKBACK_HOURS=168
# XP_RECONCILE_MIN_AGE_SECONDS=120
# XP_RECONCILE_BATCH_LIMIT=100
